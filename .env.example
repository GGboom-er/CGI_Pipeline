# ── CGI Pipeline v2.0 — 环境变量模板 ──
# 使用方法：复制此文件为 .env，然后按你的实际环境修改值
# cp .env.example .env

# ── 项目路径（改为你的实际路径）──
PROJECT_ROOT=Y:\GGbommer\scripts\Notes\Tools\_managed\cgi_pipeline
CGI_PIPELINE_PYTHON=Y:\GGbommer\scripts\Notes\Tools\_managed\conda_envs\cgi_pipeline\python.exe

# ── Maya 配置 ──
MAYAPY_PATH=C:\Program Files\Autodesk\Maya2025\bin\mayapy.exe
MAYA_BIN_DIR=C:\Program Files\Autodesk\Maya2025\bin

# ── Blender 配置（可选）──
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe

# ── UE 配置（可选）──
UE_EDITOR_CMD=C:\Program Files\Epic Games\UE_5.5\Engine\Binaries\Win64\UnrealEditor-Cmd.exe
UE_PROJECT_PATH=

# ── Redis / Memurai（默认端口 6379）──
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_RESULT_URL=redis://127.0.0.1:6379/1
REDIS_SERVER_PATH=Y:\GGbommer\scripts\Notes\Tools\_managed\redis\redis-server.exe
REDIS_CONFIG_PATH=Y:\GGbommer\scripts\Notes\Tools\_managed\redis\redis.windows.conf

# ── MCP Server ──
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=streamable-http

# ── Worker 资源阈值 ──
IPC_TIMEOUT_SEC=0
WORKER_MAX_ASSETS=50
WORKER_MAX_MEMORY_GB=2.0
IPC_POLL_INTERVAL_SEC=0.2

# ── Celery ──
CELERY_POOL=solo
FLOWER_PORT=5555
