{
  "workflow_id": "tex_to_rig_verify",
  "name": "贴图资产 → 绑定校验",
  "description": "Blender 导出 source ABC → Maya 打开 rig 一次并场景内采集 target 信息 → 写出 compare_result。",
  "steps": [
    {
      "step_id": "export_abc",
      "skill_id": "blender_export_abc",
      "parameters": {
        "abc_path": "{{input.info_dir}}/{{input.source_path | stem}}.abc",
        "cache_group": "{{config.stages.tex.geom_roots.0}}"
      }
    },
    {
      "step_id": "compare",
      "skill_id": "maya_compare_asset_in_scene",
      "source_path": "{{input.rig_path}}",
      "parameters": {
        "input_source": "{{outputs.export_abc.output_path}}",
        "output_path": "{{input.info_dir}}/{{input.source_path | stem}}_vs_{{input.rig_path | stem}}_compare_result.json",
        "cache_group": "{{config.stages.rig.geom_roots.0}}",
        "label_source": "tex",
        "label_target": "rig"
      }
    }
  ]
}
