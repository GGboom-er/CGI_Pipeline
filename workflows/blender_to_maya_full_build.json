{
  "workflow_id": "blender_to_maya_full_build",
  "status": "active",
  "runtime_lifecycle": "temporary",
  "name": "Blender 导出 → Maya PyAlembic 构建 + 材质赋予",
  "description": "从Blender构建Maya并保存。pack_textures=false保留服务器贴图；true时由完整工作流收集贴图、赋材、保存，最后自动生成单资产ZIP，包内只含Maya和对应贴图。",
  "parameters": {
    "pack_textures": {"type": "boolean", "default": false, "description": "收集贴图并使用改写材质，保存后自动打包本资产Maya和贴图。"}
  },
  "source_resolution": {
    "pipeline": "model",
    "ext_filter": [
      ".blend"
    ],
    "required": true
  },
  "steps_include": {
    "fragment": "fragments/blender_to_maya_build.json",
    "variants": [
      {
        "when": {"pack_textures": true},
        "insert_after": {
          "extract_materials": [
            {
              "step_id": "package_textures",
              "api_id": "pipeline.pipeline.package_textures",
              "parameters": {
                "materials_path": "{{outputs.extract_materials.output_path}}",
                "output_path": "{{input.info_dir}}/{{input.source_name | stem}}_materials_packaged.json",
                "texture_dir": "{{input.run_dir}}/sourceimages"
              }
            }
          ],
          "save": [
            {
              "step_id": "package_asset",
              "api_id": "pipeline.pipeline.package_asset",
              "parameters": {
                "scene_path": "{{outputs.save.output_path}}",
                "materials_path": "{{outputs.package_textures.output_path}}",
                "output_path": "{{input.run_dir}}/delivery/characters/{{outputs.save.output_path | stem}}.zip"
              }
            }
          ]
        },
        "overrides": {
          "apply_materials": {"parameters": {"materials_path": "{{outputs.package_textures.output_path}}"}}
        }
      }
    ]
  }
}
