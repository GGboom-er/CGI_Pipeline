{
  "workflow_id": "tex_to_rig_verify_and_sync",
  "status": "active",
  "runtime_lifecycle": "temporary",
  "resident_when": [
    {"mode": "geometry", "save_result": false},
    {"mode": "geometry_materials", "save_result": false}
  ],
  "name": "贴图资产 → 绑定校验 / 几何同步 / 几何材质同步",
  "description": "默认 check 仅解析、导出 ABC、对比；geometry 同步几何；geometry_materials 加入材质提取与赋予。同步后仅 save_result=true 保存；false 保留工作区中的当前场景修改，不将暂存文件称为已保存结果。",
  "parameters": {
    "mode": {"type": "string", "default": "check", "enum": ["check", "geometry", "geometry_materials"], "description": "校验、几何同步或几何材质同步。"},
    "save_result": {"type": "boolean", "default": false, "description": "同步验证后保存结果；check 模式不可为 true。"}
  },
  "reject": [{"when": {"mode": "check", "save_result": true}, "error": "mode=check does not allow save_result=true"}],
  "steps_include": {
    "fragment": "fragments/tex_to_rig_geometry.json",
    "variants": [
      {
        "when": {"mode": "check"},
        "select": [
          "resolve_files",
          "export_abc",
          "check_hierarchy_pre",
          "fix_hierarchy_pre",
          "compare_pre"
        ],
        "overrides": {
          "compare_pre": {
            "parameters": {
              "output_path": "{{input.info_dir}}/{{outputs.resolve_files.result.source_stem}}_vs_{{outputs.resolve_files.result.rig_stem}}_compare_result.json"
            }
          }
        }
      },
      {
        "when": {"mode": "geometry_materials"},
        "insert_after": {
      "export_abc": [
        {
          "step_id": "extract_materials",
          "parameters": {
            "output_path": "{{input.info_dir}}/{{outputs.resolve_files.result.source_stem}}_materials.json",
            "cache_group": "{{config.stages.tex.geom_roots.0}}"
          },
          "api_id": "blender.asset.blender_extract_materials"
        }
      ],
      "fix_shapes": [
        {
          "step_id": "assign_materials",
          "parameters": {
            "materials_path": "{{outputs.extract_materials.output_path}}",
            "target_group": "{{outputs.fix_hierarchy_pre.result.active_rig_root}}"
          },
          "api_id": "maya.asset.maya_apply_materials"
        }
      ]
        }
      }
    ]
  }
}
