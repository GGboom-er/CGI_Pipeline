{
  "workflow_id": "tex_to_rig_verify_and_sync",
  "status": "active",
  "name": "贴图资产 → 绑定校验 + ABC拼装 + 材质赋予 + 升版本",
  "description": "解析资产 tex/rig 文件（支持只传资产名或显式路径）→ Blender 导出 ABC + 抽材质 → Maya 打开 rig 一次 → 层级预检与修复 → 场景内对比生成 compare_result → 按 compare_result 增量拼装 → 拼装后层级与对比验证 → 升版本。",
  "steps": [
    {
      "step_id": "resolve_files",
      "skill_id": "resolve_asset_files",
      "parameters": {}
    },
    {
      "step_id": "export_abc",
      "skill_id": "blender_export_abc",
      "source_path": "{{outputs.resolve_files.result.source_path}}",
      "parameters": {
        "abc_path": "{{input.info_dir}}/{{outputs.resolve_files.result.source_stem}}.abc",
        "cache_group": "{{config.stages.tex.geom_roots.0}}"
      }
    },
    {
      "step_id": "extract_materials",
      "skill_id": "blender_extract_materials",
      "parameters": {
        "output_path": "{{input.info_dir}}/{{outputs.resolve_files.result.source_stem}}_materials.json",
        "cache_group": "{{config.stages.tex.geom_roots.0}}"
      }
    },
    {
      "step_id": "check_hierarchy_pre",
      "skill_id": "maya_check_asset_hierarchy",
      "source_path": "{{outputs.resolve_files.result.rig_path}}",
      "parameters": {
        "stage": "rig",
        "phase": "pre_sync",
        "block_on_fail": false,
        "block_extra_top_nodes": false
      }
    },
    {
      "step_id": "fix_hierarchy_pre",
      "skill_id": "maya_fix_asset_hierarchy",
      "parameters": {
        "check_result": "{{outputs.check_hierarchy_pre.result}}",
        "delete_extra_top_nodes": true
      }
    },
    {
      "step_id": "compare_pre",
      "skill_id": "maya_compare_asset_in_scene",
      "parameters": {
        "input_source": "{{outputs.export_abc.output_path}}",
        "output_path": "{{input.info_dir}}/{{outputs.resolve_files.result.rig_stem}}_pre_compare_result.json",
        "cache_group": "{{outputs.fix_hierarchy_pre.result.active_rig_root}};{{config.stages.rig.geom_roots.0}}",
        "label_source": "tex",
        "label_target": "rig"
      }
    },
    {
      "step_id": "normalize_uvsets",
      "skill_id": "simplify_uvsets",
      "parameters": {
        "cache_group": "{{outputs.fix_hierarchy_pre.result.active_rig_root}}"
      }
    },
    {
      "step_id": "sync",
      "skill_id": "maya_sync_rig_incremental",
      "source_path": "{{outputs.resolve_files.result.rig_path}}",
      "parameters": {
        "source_abc": "{{outputs.export_abc.output_path}}",
        "compare_result": "{{outputs.compare_pre.compare_result}}",
        "cache_group": "{{outputs.fix_hierarchy_pre.result.active_rig_root}};{{config.stages.rig.geom_roots.0}}"
      }
    },
    {
      "step_id": "check_hierarchy_post",
      "skill_id": "maya_check_asset_hierarchy",
      "parameters": {
        "stage": "rig",
        "phase": "post_sync",
        "block_on_fail": true,
        "block_extra_top_nodes": false
      }
    },
    {
      "step_id": "fix_shapes",
      "skill_id": "maya_fix_shape_names",
      "parameters": {
        "target_group": "{{config.stages.rig.geom_roots.0}}"
      }
    },
    {
      "step_id": "assign_materials",
      "skill_id": "maya_apply_materials",
      "parameters": {
        "materials_path": "{{outputs.extract_materials.output_path}}",
        "target_group": "{{config.stages.rig.geom_roots.0}}"
      }
    },
    {
      "step_id": "verify",
      "skill_id": "maya_compare_asset_in_scene",
      "parameters": {
        "input_source": "{{outputs.export_abc.output_path}}",
        "output_path": "{{input.info_dir}}/{{outputs.resolve_files.result.rig_stem}}_post_compare_result.json",
        "cache_group": "{{config.stages.rig.geom_roots.0}}",
        "label_source": "tex",
        "label_target": "rig_post"
      }
    },
    {
      "step_id": "save",
      "skill_id": "save_scene",
      "parameters": {}
    }
  ]
}
